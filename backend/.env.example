# Backend Environment Variables for INGRES AI

# ======================
# Supabase Configuration
# ======================
# Get these from: https://supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ======================
# Flask Configuration
# ======================
FLASK_ENV=development
FLASK_DEBUG=True

# Port for Flask server (default: 5000)
PORT=5000

# ======================
# Machine Learning Model
# ======================
# Model file path (relative to backend directory)
MODEL_PATH=models/groundwater_predictor.pkl

# ======================
# Optional: External APIs
# ======================
# Add any external API keys here
# WEATHER_API_KEY=your-weather-api-key
# SATELLITE_API_KEY=your-satellite-api-key
